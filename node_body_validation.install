<?php

/**
 * @file
 * Web/modules/custom/node_body_validation/node_body_validation.install.
 */

declare(strict_types=1);

use Drupal\node_body_validation\Service\SettingsMigration;
use Drupal\node_body_validation\Service\SettingsNormalizer;

/**
 * Migrates old body settings without accessing title-validation configuration.
 */
function node_body_validation_update_8001(): void {
  (new SettingsMigration(\Drupal::configFactory(), new SettingsNormalizer()))->migrate();
}

/**
 * Converts body rules to typed settings and removes obsolete configuration.
 */
function node_body_validation_update_110001(): void {
  (new SettingsMigration(\Drupal::configFactory(), new SettingsNormalizer()))->migrate();
}
